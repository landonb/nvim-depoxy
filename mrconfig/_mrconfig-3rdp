# 2021-08-18: matchit Refs:
# - Original matchit.vim, 1.13.2 [2008-01-29], by Benji Fisher:
#   - https://www.vim.org/scripts/script.php?script_id=39
# - On GitHub:
#   - v1.17: https://github.com/adelarsq/vim-matchit
#   - v1.18, https://github.com/chrisbra/matchit (and vimscript-4)
# - See also: vim-python-matchit
# CALSO: voithos/vim-python-matchit, below
[chrisbra/start/matchit]
lib = remote_set starter https://github.com/chrisbra/matchit.git
infuse = link_private_exclude "$@"
rebase =
  pull_latest "starter" "master" "HEAD"
  # CXREF: fb598fb 2019-03-05 "Add file maybe generated by :helptags"
  # - Aka maybe-definitely it was.
  # - And it doesn't belong in the repo.
  if git ls-files --error-unmatch -- "doc/tags" >/dev/null 2>&1; then
    git rm -- "doc/tags"
    git commit -m "Bugfix: Remove doc/tags (:Helptags asset)"
  fi

